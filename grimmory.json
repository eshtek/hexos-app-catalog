{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "initial install script"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Media"],
    "specifications": ["2CORE", "2GBRAM"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30396]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Media)",
      "network_share": true
    },
    { "path": "$LOCATION(Media)/books"},
    { "path": "$LOCATION(Media)/grimmory"},
    { "path": "$LOCATION(Media)/grimmory/bookdrop"},
    { "path": "$LOCATION(ApplicationsPerformance)/grimmory/data", "owner": { "user": "apps" }, "snapshot": { "id": "data" } },
    { "path": "$LOCATION(ApplicationsPerformance)/grimmory/database", "owner": { "user": "apps" }, "snapshot": { "id": "db" } },
    { "path": "$LOCATION(Media)/manga"},
    { "path": "$LOCATION(Media)/comics"},
    { "path": "$LOCATION(Media)/audiobooks"}
  ],
  "app_values": {
    "grimmory": {
      "db_password": "$RANDOM_STRING(16)",
      "db_root_password": "$RANDOM_STRING(16)"
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30396
      }
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/grimmory/data)",
      "books": "$HOST_PATH($LOCATION(Media)/books)",
      "bookdrop": "$HOST_PATH($LOCATION(Media)/grimmory/bookdrop)",
      "mariadb_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/grimmory/database)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media)/audiobooks, /audiobooks)",
        "$MOUNTED_HOST_PATH($LOCATION(Media)/comics, /comics)",
        "$MOUNTED_HOST_PATH($LOCATION(Media)/manga, /manga)"
      ]
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  }
}