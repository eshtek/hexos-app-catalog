{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "ApplicationsCapacity"],
    "specifications": ["2CORE", "4GBRAM"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30146, 25565, 25566, 25567, 25568, 25569, 25570, 25571, 25572, 25573, 25574, 25575, 19132]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)"
    },
    { "path": "$LOCATION(ApplicationsCapacity)/crafty-4/backups", "owner": { "user": "apps" }, "snapshot": { "id": "backups" } },
    { "path": "$LOCATION(ApplicationsPerformance)/crafty-4/config", "owner": { "user": "apps" }, "snapshot": { "id": "config" } },
    { "path": "$LOCATION(ApplicationsPerformance)/crafty-4/import", "owner": { "user": "apps" }, "snapshot": { "id": "import" } },
    { "path": "$LOCATION(ApplicationsPerformance)/crafty-4/logs", "owner": { "user": "apps" }, "snapshot": { "id": "logs" } },
    { "path": "$LOCATION(ApplicationsCapacity)/crafty-4/servers", "owner": { "user": "apps" }, "snapshot": { "id": "data" } }
  ],
  "app_values": {
    "crafty": {
      "additional_envs": []
    },
    "labels": [],
    "network": {
      "host_network": false,
      "web_port": {
        "bind_mode": "published",
        "host_ips": [],
        "port_number": 30146
      },
      "additional_ports": [
        {
          "bind_mode": "published",
          "host_ips": [],
          "port_number": 19132,
          "container_port": 19132,
          "protocol": "udp"
        }
      ],
      "additional_port_ranges": [
        {
          "bind_mode": "published",
          "host_ips": [],
          "protocol": "tcp",
          "start": 25565,
          "end": 25575
        }
      ]
    },
    "storage": {
      "backups": "$HOST_PATH($LOCATION(ApplicationsCapacity)/crafty-4/backups)",
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/crafty-4/config)",
      "import": "$HOST_PATH($LOCATION(ApplicationsPerformance)/crafty-4/import)",
      "logs": "$HOST_PATH($LOCATION(ApplicationsPerformance)/crafty-4/logs)",
      "servers": "$HOST_PATH($LOCATION(ApplicationsCapacity)/crafty-4/servers)"
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": 4096
      }
    }
  }
}
