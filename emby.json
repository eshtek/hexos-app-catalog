{
  "version": 6,
  "script": {
    "version": "2.0.0",
    "changeLog": "V5 with post-install hook for automated Emby configuration"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "ApplicationsCapacity", "Media", "Photos", "Music", "Movies", "Shows", "Videos"],
    "specifications": ["2CORE", "512MB"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [9096, 8920]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)"
    },
    {
      "path": "$LOCATION(Media)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Photos)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Music)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Movies)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Shows)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Videos)",
      "network_share": true
    },
    { "path": "$LOCATION(ApplicationsPerformance)/emby/config", "snapshot": { "id": "config" } },
    { "path": "$LOCATION(ApplicationsPerformance)/emby/cache" },
    { "path": "$LOCATION(ApplicationsPerformance)/emby/transcode" }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/emby/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)",
        "$MOUNTED_HOST_PATH($LOCATION(Photos), /photos)",
        "$MOUNTED_HOST_PATH($LOCATION(Music), /music)",
        "$MOUNTED_HOST_PATH($LOCATION(Movies), /movies)",
        "$MOUNTED_HOST_PATH($LOCATION(Shows), /shows)",
        "$MOUNTED_HOST_PATH($LOCATION(Videos), /videos)"
      ]
    },
    "network": {
      "http_port": {
        "bind_mode": "published",
        "port_number": 9096
      },
      "https_port": {
        "bind_mode": "published",
        "port_number": 8920
      }
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 4096)"
      },
      "gpus": "$GPU_CONFIG()"
    }
  },
  "hooks": [
    {
      "id": "configure-emby",
      "title": "Pre-configure Emby",
      "description": "Setting up Emby",
      "events": [
        "onAfterInstall"
      ],
      "optional": false,
      "userOptional": {
        "description": "Automatically set up your server, apply preferences, and create media libraries. By enabling this, you agree that HexOS will accept the Emby Terms of Service on your behalf.",
        "default": true,
        "link": {
          "url": "https://emby.media/terms.html",
          "label": "Emby Terms of Service"
        }
      },
      "inputs": [
        {
          "type": "question",
          "id": "admin_username",
          "question": {
            "question": "Emby username",
            "description": "This will be the admin username for your Emby server once installed.",
            "type": "text",
            "key": "admin_username",
            "required": true
          }
        },
        {
          "type": "question",
          "id": "admin_password",
          "question": {
            "question": "Emby password",
            "description": "This will be the admin password for your Emby server once installed.",
            "type": "password",
            "key": "admin_password",
            "required": true
          }
        },
        {
          "type": "question",
          "id": "server_name",
          "question": {
            "question": "Server name",
            "type": "text",
            "key": "server_name",
            "required": false,
            "default": "HexOS Emby",
            "description": "The name your Emby server will appear as to you and your friends.",
            "placeholder": "HexOS Emby"
          }
        }
      ],
      "script": "emby/emby_hook.ts",
      "entrypoint": "afterInstall",
      "timeout": 300,
      "retries": 0
    }
  ],
  "widgetsSchema": 2,
  "widgets": [
    {
      "id": "overview",
      "title": "Server overview",
      "description": "Emby server activity at a glance.",
      "refresh": 3600,
      "sizes": {
        "large": {
          "slots": [
            {
              "type": "text",
              "field": "status"
            }
          ]
        }
      },
      "scriptContent": "export const run = async () => ({ fields: { status: { type: \"text\", text: \"Emby widgets are coming soon.\" } } });",
      "entrypoint": "run"
    }
  ]
}
