{
  "version": 6,
  "script": {
    "version": "2.4.0",
    "changeLog": "Uses the sign-in you choose as Emby's administrator, which Seerr signs in with too. A Emby you already have gets it as an administrator of its own when you add it to a collection"
  },
  "sign_in": {
    "username": true,
    "adds_user": true
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "ApplicationsCapacity",
      "Media",
      "Photos",
      "Music",
      "Movies",
      "Shows",
      "Videos"
    ],
    "specifications": [
      "2CORE",
      "512MB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      9096,
      8920
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)"
    },
    {
      "path": "$LOCATION(Media)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Photos)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Music)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Movies)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Shows)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Videos)",
      "network_share": true
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/emby/config",
      "snapshot": {
        "id": "config"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/emby/cache"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/emby/transcode"
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/emby/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media), /media)",
        "$MOUNTED_HOST_PATH($LOCATION(Photos), /photos)",
        "$MOUNTED_HOST_PATH($LOCATION(Music), /music)",
        "$MOUNTED_HOST_PATH($LOCATION(Movies), /movies)",
        "$MOUNTED_HOST_PATH($LOCATION(Shows), /shows)",
        "$MOUNTED_HOST_PATH($LOCATION(Videos), /videos)"
      ]
    },
    "network": {
      "http_port": {
        "bind_mode": "published",
        "port_number": 9096
      },
      "https_port": {
        "bind_mode": "published",
        "port_number": 8920
      }
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 4096)"
      },
      "gpus": "$GPU_CONFIG()"
    }
  },
  "hooks": [
    {
      "id": "configure-emby",
      "title": "Pre-configure Emby",
      "events": [
        "onAfterInstall",
        "userAction"
      ],
      "rerun": "converge",
      "surfaces": [
        "card"
      ],
      "script": "emby/emby_hook.ts",
      "entrypoint": "afterInstall",
      "timeout": 900,
      "description": "Setting up Emby",
      "optional": true,
      "retries": 0,
      "userOptional": {
        "description": "Automatically set up your server, apply preferences, and create media libraries. By enabling this, you agree that HexOS will accept the Emby Terms of Service on your behalf.",
        "default": true,
        "link": {
          "url": "https://emby.media/terms.html",
          "label": "Emby Terms of Service"
        }
      }
    },
    {
      "id": "connect-seerr",
      "title": "Connect to Seerr",
      "description": "Sets Seerr up with this Emby server, so you sign in to Seerr with your Emby account.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "seerr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "seerr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "emby"
        }
      ],
      "requiresHooks": [
        "configure-emby"
      ],
      "rerun": "converge",
      "script": "emby/connect_seerr.ts",
      "entrypoint": "run",
      "timeout": 900,
      "retries": 0
    }
  ],
  "widgetsSchema": 3,
  "widgets": [
    {
      "id": "now-playing",
      "title": "Now playing",
      "description": "Active Emby streams right now.",
      "refresh": 5,
      "conditions": [
        {
          "role": "availability",
          "type": "appRunning",
          "app": "emby"
        }
      ],
      "background": {
        "field": "sessions"
      },
      "slots": [
        {
          "type": "list",
          "field": "sessions",
          "rows": 1
        }
      ],
      "script": "emby/widget_now_playing.ts",
      "entrypoint": "run",
      "timeout": 10
    }
  ]
}
