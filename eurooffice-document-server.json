{
  "version": 6,
  "internal": true,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial curation: edits documents inside OpenCloud over https, with nothing to copy"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance"
    ],
    "specifications": [
      "2CORE",
      "2GB",
      "2GBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30461
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/eurooffice/postgres_data",
      "owner": {
        "user": "netdata",
        "group": "docker"
      },
      "snapshot": {
        "id": "db"
      }
    }
  ],
  "app_values": {
    "eurooffice": {
      "postgres_image_selector": "postgres_18_image",
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "jwt_secret": "$RANDOM_STRING(40)",
      "additional_envs": [
        {
          "name": "ALLOW_PRIVATE_IP_ADDRESS",
          "value": "true"
        },
        {
          "name": "USE_UNAUTHORIZED_STORAGE",
          "value": "true"
        }
      ]
    },
    "storage": {
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/eurooffice/postgres_data)"
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": "$PORT(30461)"
      },
      "certificate_id": 1
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(15%, 4096)"
      }
    }
  }
}
