{
  "version": 6,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial curation: a TShock world with its admin setup code on the app's card and Settings tab"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance"
    ],
    "specifications": [
      "2CORE",
      "2GBRAM",
      "1GB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      7777
    ],
    "game_port": 7777,
    "instances": "many"
  },
  "installation_questions": [
    {
      "question": "World size",
      "type": "select",
      "key": "world_size",
      "required": true,
      "installonly": true,
      "default": "2",
      "options": [
        { "text": "Small", "value": "1" },
        { "text": "Medium", "value": "2" },
        { "text": "Large", "value": "3" }
      ]
    },
    {
      "question": "Difficulty",
      "type": "select",
      "key": "world_difficulty",
      "required": true,
      "installonly": true,
      "default": "0",
      "options": [
        { "text": "Classic", "value": "0" },
        { "text": "Expert", "value": "1" },
        { "text": "Master", "value": "2" },
        { "text": "Journey", "value": "3" }
      ]
    },
    {
      "question": "Password",
      "description": "Players type it when they join.",
      "type": "password",
      "key": "password",
      "required": false,
      "default": "",
      "placeholder": "Leave blank for no password"
    }
  ],
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/$INSTANCE(terraria-tshock)/config",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "config"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/$INSTANCE(terraria-tshock)/worlds",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "worlds"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/$INSTANCE(terraria-tshock)/plugins",
      "owner": {
        "user": "apps"
      }
    }
  ],
  "app_values": {
    "terraria": {
      "world_size": "$QUESTION(world_size)",
      "world_difficulty": "$QUESTION(world_difficulty)",
      "password": "$QUESTION(password)"
    },
    "network": {
      "server_port": {
        "bind_mode": "published",
        "port_number": "$PORT(7777)"
      },
      "api_port": {
        "bind_mode": "",
        "port_number": 7878
      }
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/$INSTANCE(terraria-tshock)/config)",
      "world": "$HOST_PATH($LOCATION(ApplicationsPerformance)/$INSTANCE(terraria-tshock)/worlds)",
      "plugins": "$HOST_PATH($LOCATION(ApplicationsPerformance)/$INSTANCE(terraria-tshock)/plugins)"
    },
    "resources": {
      "limits": {
        "cpus": "$CPUS(50%, 2)",
        "memory": "$MEMORY(25%, 2048)"
      }
    }
  },
  "widgets": [
    {
      "id": "setup",
      "title": "Admin setup",
      "description": "The one-time code that makes the first player to type it TShock's admin.",
      "refresh": 30,
      "conditions": [
        {
          "role": "availability",
          "type": "appRunning",
          "app": "terraria-tshock"
        }
      ],
      "slots": [
        { "type": "stat", "field": "setup" }
      ],
      "settings": [{ "field": "setup" }],
      "script": "terraria-tshock/widget_setup.ts",
      "entrypoint": "run",
      "timeout": 5
    }
  ],
  "widgetsSchema": 3
}
