{
  "version": 6,
  "script": {
    "version": "1.3.0",
    "changeLog": "Uses the sign-in you choose, still opening without it on your home network, and keeps downloads in progress apart from finished ones"
  },
  "sign_in": {
    "username": true
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "ApplicationsCapacity",
      "Downloads"
    ],
    "specifications": [
      "2CORE",
      "200MB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30024,
      51413
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)"
    },
    {
      "path": "$LOCATION(Downloads)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Downloads)/qbittorrent"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/qbittorrent/config",
      "snapshot": {
        "id": "config"
      }
    }
  ],
  "app_values": {
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30024
      }
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/qbittorrent/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Downloads)/qbittorrent, /config/Downloads)"
      ]
    }
  },
  "hooks": [
    {
      "id": "seed-webui",
      "title": "Set qBittorrent's sign-in",
      "description": "Sets the sign-in you chose before qBittorrent's first start, and lets your home network in without it",
      "events": [
        "onBeforeInstall"
      ],
      "optional": true,
      "script": "qbittorrent/seed_webui.ts",
      "entrypoint": "seedWebUi",
      "timeout": 60
    },
    {
      "id": "configure-qbittorrent",
      "title": "Pre-configure qBittorrent",
      "description": "Gives qBittorrent the sign-in you chose and a folder for downloads in progress",
      "events": [
        "onAfterInstall",
        "userAction"
      ],
      "rerun": "converge",
      "surfaces": [
        "card"
      ],
      "optional": true,
      "script": "qbittorrent/configure.ts",
      "entrypoint": "configure",
      "timeout": 900,
      "retries": 0
    }
  ]
}
