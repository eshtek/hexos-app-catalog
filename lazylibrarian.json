{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial Script"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance", "Media", "Downloads"
    ],
    "specifications": [
      "2CORE",
      "2GBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [31089]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    { "path": "$LOCATION(Media)", "network_share": true },
    { "path": "$LOCATION(Downloads)", "network_share": true },
    { "path": "$LOCATION(ApplicationsPerformance)/lazylibrarian/config", "owner": { "user": "apps" }, "snapshot": { "id": "config" } },
    { "path": "$LOCATION(Media)/books" },
    { "path": "$LOCATION(Media)/audiobooks" },
    { "path": "$LOCATION(Downloads)/lazylibrarian" },
    { "path": "$LOCATION(Downloads)/qbittorrent" }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/lazylibrarian/config)",
      "downloads": "$HOST_PATH($LOCATION(Downloads)/lazylibrarian)",
      "books": "$HOST_PATH($LOCATION(Media)/books)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media)/audiobooks, /audiobooks)",
        "$MOUNTED_HOST_PATH($LOCATION(Downloads)/qbittorrent, /config/Downloads)"
      ]
    }
  },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 31089
      }
    },
  "resources": {
    "limits": {
      "cpus": 2,
      "memory": "$MEMORY(10%, 2048)"
    }
  }
}
