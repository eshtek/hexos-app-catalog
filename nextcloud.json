{
  "version": 6,
  "script": {
    "version": "2.0.0",
    "changeLog": "Nextcloud can connect to Collabora, Draw.io, Paperless and Ollama from its Connections tab. Nothing changes until you connect one."
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "ApplicationsCapacity"
    ],
    "specifications": [
      "2CORE",
      "2GB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30027
    ]
  },
  "installation_questions": [
    {
      "question": "Nextcloud Username",
      "description": "Create a username for the admin account. You'll use this to log in via web and mobile apps.",
      "type": "text",
      "key": "admin_user",
      "required": true
    },
    {
      "question": "Nextcloud Password",
      "description": "Create a password for the admin account, or press the button to generate one. You'll need this to log in via web browser and mobile apps, so copy it somewhere safe.",
      "type": "password",
      "key": "admin_password",
      "required": true,
      "default": "$RANDOM_STRING(16)"
    },
    {
      "question": "Default Phone Region",
      "description": "Two-letter country code (US, CA, GB, DE, FR, AU, etc.). This helps format phone numbers correctly. Common codes: US (United States), CA (Canada), GB (United Kingdom), DE (Germany), FR (France), AU (Australia). Leave blank if unsure.",
      "type": "text",
      "key": "phone_region",
      "required": false,
      "default": "US"
    }
  ],
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nextcloud/html",
      "owner": {
        "user": "www-data"
      },
      "snapshot": {
        "id": "html"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nextcloud/postgres_data",
      "owner": {
        "user": "netdata",
        "group": "docker"
      },
      "snapshot": {
        "id": "db"
      }
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)"
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)/nextcloud/data",
      "snapshot": {
        "id": "data"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nextcloud/startup",
      "owner": {
        "user": "www-data"
      },
      "snapshot": {
        "id": "startup"
      },
      "start_mount": "/docker-entrypoint-hooks.d/before-starting"
    }
  ],
  "app_values": {
    "nextcloud": {
      "admin_user": "$QUESTION(admin_user)",
      "admin_password": "$QUESTION(admin_password)",
      "redis_password": "$RANDOM_STRING(16)",
      "db_password": "$RANDOM_STRING(16)",
      "host": "$SERVER_LAN_IP",
      "postgres_image_selector": "postgres_17_image",
      "apt_packages": [
        "ffmpeg",
        "smbclient",
        "ocrmypdf",
        "libreoffice"
      ],
      "tesseract_languages": [
        "eng",
        "spa",
        "fra",
        "deu",
        "por",
        "ita",
        "nld",
        "pol",
        "rus",
        "jpn",
        "chi_sim",
        "ara"
      ],
      "imaginary": {
        "enabled": true
      },
      "cron": {
        "enabled": true,
        "schedule": "*/5 * * * *"
      },
      "additional_envs": [
        {
          "name": "NC_default_phone_region",
          "value": "$QUESTION(phone_region)"
        },
        {
          "name": "NC_maintenance_window_start",
          "value": "1"
        }
      ]
    },
    "storage": {
      "html": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nextcloud/html)",
      "data": "$HOST_PATH($LOCATION(ApplicationsCapacity)/nextcloud/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nextcloud/postgres_data)"
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": "$PORT(30027)"
      }
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  },
  "hooks": [
    {
      "id": "seed-startup",
      "title": "Prepare Nextcloud's start-up folder",
      "description": "Lets HexOS connect Nextcloud to your other apps.",
      "events": [
        "onBeforeInstall"
      ],
      "optional": true,
      "script": "nextcloud/startup.ts",
      "entrypoint": "seed",
      "timeout": 60,
      "retries": 0
    },
    {
      "id": "configure-nextcloud",
      "title": "Finish setting up Nextcloud",
      "description": "Waits for Nextcloud to finish its first start, which takes a few minutes.",
      "events": [
        "onAfterInstall",
        "userAction"
      ],
      "rerun": "converge",
      "surfaces": [
        "card"
      ],
      "optional": true,
      "script": "nextcloud/startup.ts",
      "entrypoint": "configure",
      "timeout": 900,
      "retries": 0
    },
    {
      "id": "connect-collabora",
      "title": "Connect to Collabora",
      "description": "Opens and edits documents in Nextcloud with Collabora.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "collabora"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "collabora"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "nextcloud"
        }
      ],
      "rerun": "converge",
      "script": "nextcloud/startup.ts",
      "entrypoint": "collabora",
      "timeout": 600,
      "retries": 0
    },
    {
      "id": "connect-drawio",
      "title": "Connect to Draw.io",
      "description": "Opens and edits diagrams in Nextcloud with Draw.io.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "drawio"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "drawio"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "nextcloud"
        }
      ],
      "rerun": "converge",
      "script": "nextcloud/startup.ts",
      "entrypoint": "drawio",
      "timeout": 600,
      "retries": 0
    },
    {
      "id": "connect-paperless-ngx",
      "title": "Connect to Paperless",
      "description": "Sends documents from Nextcloud to Paperless.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "paperless-ngx"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "paperless-ngx"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "nextcloud"
        }
      ],
      "rerun": "converge",
      "script": "nextcloud/startup.ts",
      "entrypoint": "paperless",
      "timeout": 600,
      "retries": 0
    },
    {
      "id": "connect-ollama",
      "title": "Connect to Ollama",
      "description": "Lets Nextcloud's Assistant use the models on your graphics card.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "ollama"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "ollama"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "nextcloud"
        }
      ],
      "rerun": "converge",
      "script": "nextcloud/startup.ts",
      "entrypoint": "ollama",
      "timeout": 600,
      "retries": 0
    }
  ]
}
