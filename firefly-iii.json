{
    "version": 6,
    "script": {
        "version": "1.0.2",
        "changeLog": "Pages and links use https at the app's Anywhere address"
    },
    "requirements": {
        "locations": [
            "ApplicationsPerformance"
        ],
        "specifications": [
          "2CORE",
          "2GB"
        ],
        "permissions": [
            "READ_WRITE_LOCATIONS"
        ],
        "ports": [
            30105
        ]
    },
    "ensure_directories_exists": [
        {
            "path": "$LOCATION(ApplicationsPerformance)"
        },
        {
            "path": "$LOCATION(ApplicationsPerformance)/firefly3"
        },
        { "path": "$LOCATION(ApplicationsPerformance)/firefly3/postgres_data", "owner": { "user": "netdata", "group": "docker" }, "snapshot": { "id": "db" } },
        { "path": "$LOCATION(ApplicationsPerformance)/firefly3/uploads", "owner": { "user": "apps"}, "snapshot": { "id": "data" } }
    ],
    "app_values": {
        "firefly_iii" : {
          "db_password": "$RANDOM_STRING(16)",
          "redis_password": "$RANDOM_STRING(16)",
          "app_key": "$RANDOM_STRING(32)",
          "app_url": "http://$SERVER_LAN_IP:$PORT(30105)"
        },
          
        "storage": {
            "uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/firefly3/uploads)",
            "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/firefly3/postgres_data)"
        },
        "network": {
            "web_port": {
                "bind_mode": "published",
                "port_number": "$PORT(30105)"
            }
        },
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "$MEMORY(10%, 2048)"
          }
        }
    },
    "hooks": [
        {
            "id": "anywhere-address",
            "title": "Enable Anywhere for Firefly III",
            "description": "Enabling Anywhere for Firefly III",
            "summary": "Firefly III's pages and links use https at its Anywhere address. HexOS runs this again when the address changes.",
            "kind": "maintain",
            "events": ["userAction"],
            "rerun": "converge",
            "rerunsOn": ["remote-address"],
            "surfaces": ["card"],
            "script": "anywhere/proxy_setting.ts",
            "entrypoint": "firefly",
            "timeout": 600,
            "retries": 0
        }
    ]
}
