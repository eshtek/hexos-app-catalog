{
  "version": 6,
  "custom": true,
  "metadata": {
    "name": "Automatic Ripping Machine",
    "description": "Put a Blu-ray, DVD or CD in the server's disc drive and it is copied to your library. Movies go to Movies, shows to Shows and music to Music. With Radarr installed, Radarr names and files each movie the way it does your others.",
    "icon": "arm/icon.png",
    "version": "2.24.4",
    "categories": ["media"],
    "keywords": ["arm", "rip", "blu-ray", "dvd", "cd", "makemkv", "disc"],
    "homepage": "https://github.com/automatic-ripping-machine/automatic-ripping-machine",
    "sources": ["https://github.com/automatic-ripping-machine/automatic-ripping-machine"]
  },
  "script": {
    "version": "1.0.0",
    "changeLog": "Rips a disc you insert and files it in Movies, Shows or Music"
  },
  "installation_questions": [
    {
      "question": "OMDb API key",
      "description": "Names each disc and tells movies from shows. Without one, rips stay in Downloads under arm, named by their disc label. Free at omdbapi.com.",
      "type": "password",
      "key": "omdb_api_key",
      "required": false,
      "default": ""
    }
  ],
  "requirements": {
    "locations": ["ApplicationsPerformance", "Downloads", "Movies", "Shows", "Music"],
    "specifications": ["2CORE", "2GBRAM"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30173]
  },
  "ensure_directories_exists": [
    { "path": "$LOCATION(ApplicationsPerformance)" },
    { "path": "$LOCATION(Downloads)", "network_share": true },
    { "path": "$LOCATION(Movies)", "network_share": true },
    { "path": "$LOCATION(Shows)", "network_share": true },
    { "path": "$LOCATION(Music)", "network_share": true },
    {
      "path": "$LOCATION(ApplicationsPerformance)/arm/config",
      "owner": { "user": "apps", "group": "apps" },
      "snapshot": { "id": "config" }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/arm/home",
      "owner": { "user": "apps", "group": "apps" },
      "snapshot": { "id": "home" }
    },
    { "path": "$LOCATION(Downloads)/arm", "owner": { "user": "apps", "group": "apps" } }
  ],
  "app_values": {
    "image": {
      "repository": "automaticrippingmachine/automatic-ripping-machine",
      "tag": "2.24.4@sha256:e0a1f285b19ab945f6c633a8557849e2e59b817701a09c46eeafc9d81111ee2e",
      "pull_policy": "missing"
    },
    "restart_policy": "unless-stopped",
    "privileged": true,
    "envs": [
      { "name": "ARM_UID", "value": "568" },
      { "name": "ARM_GID", "value": "568" },
      { "name": "HEXOS_OMDB_API_KEY", "value": "$QUESTION(omdb_api_key)" }
    ],
    "ports": [
      {
        "bind_mode": "published",
        "port_number": "$PORT(30173)",
        "container_port": 8080,
        "protocol": "tcp",
        "host_ips": []
      }
    ],
    "portals": [
      {
        "name": "Web UI",
        "scheme": "http",
        "use_node_ip": true,
        "host": "",
        "port": "$PORT(30173)",
        "path": "/"
      }
    ],
    "storage": [
      {
        "type": "host_path",
        "mount_path": "/etc/arm/config",
        "host_path_config": { "path": "$LOCATION(ApplicationsPerformance)/arm/config" }
      },
      {
        "type": "host_path",
        "mount_path": "/home/arm",
        "host_path_config": { "path": "$LOCATION(ApplicationsPerformance)/arm/home" }
      },
      {
        "type": "host_path",
        "mount_path": "/home/arm/media",
        "host_path_config": { "path": "$LOCATION(Downloads)/arm" }
      },
      {
        "type": "host_path",
        "mount_path": "/home/arm/music",
        "host_path_config": { "path": "$LOCATION(Music)" }
      },
      {
        "type": "host_path",
        "mount_path": "/movies",
        "host_path_config": { "path": "$LOCATION(Movies)" }
      },
      {
        "type": "host_path",
        "mount_path": "/shows",
        "host_path_config": { "path": "$LOCATION(Shows)" }
      }
    ],
    "resources": {
      "enable_resource_limits": true,
      "limits": { "cpus": "$CPUS(50%, 4)", "memory": "$MEMORY(25%, 4096)" }
    }
  },
  "hooks": [
    {
      "id": "prepare-folders",
      "title": "Prepare Automatic Ripping Machine's folders",
      "description": "Preparing folders",
      "events": ["onBeforeInstall", "onBeforeUpgrade"],
      "script": "arm/configure.ts",
      "entrypoint": "prepare",
      "timeout": 60
    },
    {
      "id": "configure-arm",
      "title": "Pre-configure Automatic Ripping Machine",
      "description": "Setting up Automatic Ripping Machine",
      "summary": "Sets rips to keep the disc's quality and go to your library. Run it again after you change the OMDb key. It keeps your other settings.",
      "events": ["onAfterInstall", "userAction"],
      "rerun": "converge",
      "surfaces": ["card"],
      "optional": true,
      "script": "arm/configure.ts",
      "entrypoint": "configure",
      "timeout": 600,
      "retries": 0
    }
  ]
}
