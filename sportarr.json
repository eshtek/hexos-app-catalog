{
  "version": 6,
  "script": {
    "version": "1.1.0",
    "changeLog": "Joins the Media library with the sign-in you choose for it, and connects to your download clients and Prowlarr in one click."
  },
  "sign_in": {
    "username": true
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Downloads", "Media"],
    "specifications": ["2CORE", "200MB"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [1867]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Downloads)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Media)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Downloads)/qbittorrent"
    },
    {
      "path": "$LOCATION(Media)/sports"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/sportarr/config",
      "snapshot": { "id": "config" }
    }
  ],
  "app_values": {
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 1867
      }
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/sportarr/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Downloads)/qbittorrent, /config/Downloads)",
        "$MOUNTED_HOST_PATH($LOCATION(Media)/sports, /media/sports)",
        "$MOUNTED_HOST_PATH($LOCATION(Downloads), /downloads)"
      ]
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  },
  "hooks": [
    {
      "id": "configure-sportarr",
      "title": "Pre-configure Sportarr",
      "description": "Setting up Sportarr",
      "events": [
        "onAfterInstall",
        "userAction"
      ],
      "rerun": "converge",
      "surfaces": [
        "card"
      ],
      "optional": true,
      "script": "sportarr/configure.ts",
      "entrypoint": "configure",
      "timeout": 900,
      "retries": 0
    },
    {
      "id": "connect-qbittorrent",
      "title": "Connect to qBittorrent",
      "description": "Sends what Sportarr grabs to qBittorrent.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "qbittorrent"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "qbittorrent"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sportarr"
        }
      ],
      "rerun": "converge",
      "script": "sportarr/connect_download_client.ts",
      "entrypoint": "qbittorrent",
      "timeout": 900,
      "retries": 0
    },
    {
      "id": "connect-deluge",
      "title": "Connect to Deluge",
      "description": "Sends what Sportarr grabs to Deluge.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "deluge"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "deluge"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sportarr"
        }
      ],
      "rerun": "converge",
      "script": "sportarr/connect_download_client.ts",
      "entrypoint": "deluge",
      "timeout": 900,
      "retries": 0
    },
    {
      "id": "connect-sabnzbd",
      "title": "Connect to SABnzbd",
      "description": "Sends what Sportarr grabs to SABnzbd.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "sabnzbd"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sabnzbd"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sportarr"
        }
      ],
      "rerun": "converge",
      "script": "sportarr/connect_download_client.ts",
      "entrypoint": "sabnzbd",
      "timeout": 120,
      "retries": 0
    },
    {
      "id": "connect-nzbget",
      "title": "Connect to NZBGet",
      "description": "Sends what Sportarr grabs to NZBGet.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "nzbget"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "nzbget"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sportarr"
        }
      ],
      "rerun": "converge",
      "script": "sportarr/connect_download_client.ts",
      "entrypoint": "nzbget",
      "timeout": 120,
      "retries": 0
    }
  ]
}
