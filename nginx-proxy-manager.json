{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial curation"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance"
    ],
    "specifications": [
      "2CORE",
      "2GB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30020,
      30021,
      30022
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nginx-proxy-manager/data",
      "snapshot": {
        "id": "data"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nginx-proxy-manager/certs",
      "snapshot": {
        "id": "certs"
      }
    }
  ],
  "app_values": {
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30020
      },
      "http_port": {
        "bind_mode": "published",
        "port_number": 30021
      },
      "https_port": {
        "bind_mode": "published",
        "port_number": 30022
      }
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nginx-proxy-manager/data)",
      "certs": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nginx-proxy-manager/certs)"
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": 1024
      }
    }
  }
}
