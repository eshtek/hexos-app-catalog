{
    "version": 5,
    "script": {
        "version": "1.0.0",
        "changeLog": "Initial"
    },
    "requirements": {
        "locations": [
            "ApplicationsPerformance",
            "ApplicationsCapacity",
            "Documents"
        ],
        "permissions": [
            "READ_WRITE_LOCATIONS"
        ],
        "ports": [
            30070
        ]
    },
    "ensure_directories_exists": [
        {
            "path": "$LOCATION(ApplicationsPerformance)"
        },
        {
            "path": "$LOCATION(ApplicationsCapacity)"
        },
        {
            "path": "$LOCATION(Documents)",
            "network_share": true
        },
        {
            "path": "$LOCATION(ApplicationsPerformance)/paperless"
        },
        { "path": "$LOCATION(ApplicationsPerformance)/paperless/postgres_data", "owner": { "user": "netdata", "group": "docker" }, "snapshot": { "id": "db" } },
        { "path": "$LOCATION(ApplicationsPerformance)/paperless/data", "owner": { "user": "apps"}, "snapshot": { "id": "data" } },
        { "path": "$LOCATION(Documents)/paperless/media", "owner": { "user": "apps" } ,  "snapshot": { "id": "media" }  },
        { "path": "$LOCATION(Documents)/paperless/consume", "owner": { "user": "apps" } },
        { "path": "$LOCATION(Documents)/paperless/export" },
        { "path": "$LOCATION(Documents)/paperless/trash", "owner": { "user": "apps" } }
    ],
    "installation_questions": [
      {
          "question": "Admin user name",
          "type": "text",
          "key": "admin_user",
          "required": true,
          "default": ""
      },
      {
        "question": "Admin user password",
        "type": "text",
        "key": "admin_password",
        "required": true,
        "default": ""
        }
    ],
    "app_values": {
        "paperless" : {
          "db_password": "$RANDOM_STRING(16)",
          "redis_password": "$RANDOM_STRING(16)",
          "secret_key": "$RANDOM_STRING(64)",
          "admin_user": "$QUESTION(admin_user)",
          "admin_password": "$QUESTION(admin_password)"
        },
          
        "storage": {
            "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/paperless/data)",
            "media": "$HOST_PATH($LOCATION(Documents)/paperless/media)",
            "consume": "$HOST_PATH($LOCATION(Documents)/paperless/consume)",
            "export": "$HOST_PATH($LOCATION(Documents)/paperless/export)",
            "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/paperless/postgres_data)",
            "trash": "$HOST_PATH($LOCATION(Documents)/paperless/trash)"
        },
        "network": {
            "web_port": {
                "bind_mode": "published",
                "port_number": 30070
            }
        }
    }
}
