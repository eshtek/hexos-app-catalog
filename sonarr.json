{
  "version": 6,
  "script": {
    "version": "1.2.0",
    "changeLog": "Pinned the web port, mounted the qBittorrent downloads at /downloads, added the Connect to qBittorrent link, and moved to the v6 install script format."
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "ApplicationsCapacity",
      "Downloads",
      "Shows"
    ],
    "specifications": [
      "2CORE",
      "200MB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30113
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)"
    },
    {
      "path": "$LOCATION(Downloads)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Shows)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Downloads)/qbittorrent"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/sonarr/config",
      "snapshot": {
        "id": "config"
      }
    }
  ],
  "app_values": {
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30113
      }
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/sonarr/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Downloads)/qbittorrent, /downloads)",
        "$MOUNTED_HOST_PATH($LOCATION(Shows), /shows)"
      ]
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  },
  "hooks": [
    {
      "id": "connect-qbittorrent",
      "title": "Connect to qBittorrent",
      "description": "Use qBittorrent on this server to download shows",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "qbittorrent"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "qbittorrent"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sonarr"
        }
      ],
      "rerun": "converge",
      "entrypoint": "connectQbittorrent",
      "timeout": 600,
      "script": "arr/connect_qbittorrent.ts"
    }
  ]
}
