{
  "version": 6,
  "script": {
    "version": "1.3.0",
    "changeLog": "Uses the sign-in you choose, still opening without it on your home network. A Prowlarr you already have gets that sign-in too when you add it to a collection"
  },
  "sign_in": {
    "username": true
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance"
    ],
    "specifications": [
      "2CORE",
      "200MB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30050
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/prowlarr/config",
      "snapshot": {
        "id": "config"
      }
    }
  ],
  "app_values": {
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30050
      }
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/prowlarr/config)"
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  },
  "hooks": [
    {
      "id": "seed-sign-in",
      "title": "Set Prowlarr's sign-in",
      "description": "Sets Prowlarr's sign-in, so it opens without one on your home network",
      "events": [
        "onBeforeInstall"
      ],
      "optional": true,
      "script": "servarr/configure.ts",
      "entrypoint": "seed",
      "timeout": 60
    },
    {
      "id": "configure-prowlarr",
      "title": "Pre-configure Prowlarr",
      "description": "Setting up Prowlarr",
      "events": [
        "onAfterInstall",
        "userAction"
      ],
      "rerun": "converge",
      "surfaces": [
        "card"
      ],
      "optional": true,
      "script": "servarr/configure.ts",
      "entrypoint": "configure",
      "timeout": 900,
      "retries": 0
    },
    {
      "id": "connect-radarr",
      "title": "Connect to Radarr",
      "description": "Keeps Radarr's indexers in sync with Prowlarr.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "radarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "radarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "prowlarr"
        }
      ],
      "rerun": "converge",
      "script": "prowlarr/connect_arr.ts",
      "entrypoint": "radarr",
      "timeout": 120,
      "retries": 0
    },
    {
      "id": "connect-sonarr",
      "title": "Connect to Sonarr",
      "description": "Keeps Sonarr's indexers in sync with Prowlarr.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "sonarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sonarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "prowlarr"
        }
      ],
      "rerun": "converge",
      "script": "prowlarr/connect_arr.ts",
      "entrypoint": "sonarr",
      "timeout": 120,
      "retries": 0
    },
    {
      "id": "connect-lidarr",
      "title": "Connect to Lidarr",
      "description": "Keeps Lidarr's indexers in sync with Prowlarr.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "lidarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "lidarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "prowlarr"
        }
      ],
      "rerun": "converge",
      "script": "prowlarr/connect_arr.ts",
      "entrypoint": "lidarr",
      "timeout": 120,
      "retries": 0
    },
    {
      "id": "connect-qbittorrent",
      "title": "Connect to qBittorrent",
      "description": "Sends what you grab in Prowlarr's own search to qBittorrent.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "qbittorrent"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "qbittorrent"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "prowlarr"
        }
      ],
      "rerun": "converge",
      "script": "servarr/connect_download_client.ts",
      "entrypoint": "qbittorrent",
      "timeout": 900,
      "retries": 0
    },
    {
      "id": "connect-deluge",
      "title": "Connect to Deluge",
      "description": "Sends what you grab in Prowlarr's own search to Deluge.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "deluge"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "deluge"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "prowlarr"
        }
      ],
      "rerun": "converge",
      "script": "servarr/connect_download_client.ts",
      "entrypoint": "deluge",
      "timeout": 900,
      "retries": 0
    },
    {
      "id": "connect-sabnzbd",
      "title": "Connect to SABnzbd",
      "description": "Sends what you grab in Prowlarr's own search to SABnzbd.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "sabnzbd"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sabnzbd"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "prowlarr"
        }
      ],
      "rerun": "converge",
      "script": "servarr/connect_download_client.ts",
      "entrypoint": "sabnzbd",
      "timeout": 120,
      "retries": 0
    },
    {
      "id": "connect-nzbget",
      "title": "Connect to NZBGet",
      "description": "Sends what you grab in Prowlarr's own search to NZBGet.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "nzbget"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "nzbget"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "prowlarr"
        }
      ],
      "rerun": "converge",
      "script": "servarr/connect_download_client.ts",
      "entrypoint": "nzbget",
      "timeout": 120,
      "retries": 0
    }
  ]
}
