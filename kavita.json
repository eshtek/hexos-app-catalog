{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Media"],
    "specifications": ["2CORE", "2GBRAM"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30069]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Media)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Media)/comics", "owner": { "user": "apps" }
    },
    {
      "path": "$LOCATION(Media)/manga", "owner": { "user": "apps" }
    },
    {
      "path": "$LOCATION(Media)/books", "owner": { "user": "apps" }
    },
    { "path": "$LOCATION(ApplicationsPerformance)/kavita/config", "owner": { "user": "apps" }, "snapshot": { "id": "config" } }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/kavita/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media)/books, /books)",
        "$MOUNTED_HOST_PATH($LOCATION(Media)/comics, /comics)",
        "$MOUNTED_HOST_PATH($LOCATION(Media)/manga, /manga)"
      ]
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30069
      }
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  }
}

