{
  "version": 6,
  "custom": true,
  "internal": false,
  "metadata": {
    "name": "Pterodactyl Wings",
    "description": "The part of Pterodactyl that runs your game servers. Each server you create in Pterodactyl Panel runs here in its own container, with its files in this app's folder.",
    "icon": "pterodactyl/icon.svg",
    "version": "1.13.4",
    "categories": ["games"],
    "keywords": ["pterodactyl", "wings", "game server", "dedicated server", "minecraft", "multiplayer"],
    "homepage": "https://pterodactyl.io/",
    "sources": ["https://github.com/pterodactyl/wings"]
  },
  "script": {
    "version": "1.0.1",
    "changeLog": "Runs ghcr.io/pterodactyl/wings v1.13.5."
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE", "4GBRAM", "20GB"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30163, 30164],
    "reserved_ports": [{ "start": 27100, "end": 27119 }]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/pterodactyl-wings/config",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "config"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/pterodactyl-wings/data",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "servers"
      }
    }
  ],
  "app_values": {
    "image": {
      "repository": "ghcr.io/pterodactyl/wings",
      "tag": "v1.13.5@sha256:6d0a513d1999e2d7930dde3fffb78fb80f38e0413452d28f64320c54f11be056",
      "pull_policy": "missing"
    },
    "restart_policy": "unless-stopped",
    "tty": true,
    "envs": [
      { "name": "WINGS_UID", "value": "568" },
      { "name": "WINGS_GID", "value": "568" },
      { "name": "WINGS_USERNAME", "value": "apps" }
    ],
    "host_network": false,
    "ports": [
      { "bind_mode": "published", "port_number": "$PORT(30163)", "container_port": 8080, "protocol": "tcp", "host_ips": [] },
      { "bind_mode": "published", "port_number": "$PORT(30164)", "container_port": 2022, "protocol": "tcp", "host_ips": [] }
    ],
    "storage": [
      {
        "type": "host_path",
        "mount_path": "/var/run/docker.sock",
        "host_path_config": {
          "path": "/var/run/docker.sock"
        }
      },
      {
        "type": "host_path",
        "mount_path": "/etc/pterodactyl",
        "host_path_config": {
          "path": "$LOCATION(ApplicationsPerformance)/pterodactyl-wings/config"
        }
      },
      {
        "type": "host_path",
        "mount_path": "$LOCATION(ApplicationsPerformance)/pterodactyl-wings/data",
        "host_path_config": {
          "path": "$LOCATION(ApplicationsPerformance)/pterodactyl-wings/data"
        }
      }
    ],
    "resources": {
      "enable_resource_limits": false
    }
  },
  "hooks": [
    {
      "id": "join-panel",
      "title": "Join Pterodactyl Panel",
      "description": "Adding this server to Pterodactyl Panel",
      "events": ["onBeforeInstall"],
      "script": "pterodactyl/setup.ts",
      "entrypoint": "joinPanel",
      "timeout": 600
    },
    {
      "id": "panel-sftp-port",
      "title": "Tell Pterodactyl Panel the file transfer port",
      "description": "Setting the file transfer port",
      "events": ["onAfterInstall"],
      "script": "pterodactyl/setup.ts",
      "entrypoint": "sftpPort",
      "timeout": 120
    }
  ]
}
