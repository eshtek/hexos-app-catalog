{
  "type": "collection",
  "version": 1,
  "name": "Office suite",
  "description": "Files, documents and passwords in one place, on your own server.",
  "image": "_collections/office.jpg",
  "groups": [
    {
      "id": "files",
      "type": "single",
      "title": "Your files",
      "description": "Where your files live. Both sync to your devices and share with the people you choose.",
      "options": [
        {
          "app": "nextcloud",
          "core": true,
          "default": true,
          "summary": "The most add-ons, with a database behind it"
        },
        {
          "app": "opencloud",
          "core": true,
          "summary": "Lighter, with files kept as plain folders in Documents",
          "answers": {
            "search": false,
            "calendars": true,
            "address": "https://$SERVER_LAN_IP:$PORT(30134)",
            "app_drawio": true,
            "app_excalidraw": false,
            "app_unzip": false,
            "app_importer": false,
            "app_external_sites": false,
            "app_json_viewer": false,
            "app_maps": false,
            "app_cast": false,
            "app_pastebin": false,
            "app_progress_bars": false,
            "app_calculator": false,
            "app_arcade": false,
            "app_apollon": false,
            "app_bpmn": false
          }
        }
      ]
    },
    {
      "id": "editor",
      "type": "single",
      "title": "Document editor",
      "description": "Edits documents together in the browser, inside your files app.",
      "options": [
        {
          "app": "collabora",
          "core": true,
          "default": true,
          "summary": "Open source, best with OpenDocument files"
        },
        {
          "app": "onlyoffice-document-server",
          "core": true,
          "summary": "Closest to Microsoft Office",
          "requires": [
            "opencloud"
          ]
        },
        {
          "app": "eurooffice-document-server",
          "summary": "A European fork of ONLYOFFICE",
          "requires": [
            "opencloud"
          ]
        }
      ]
    },
    {
      "id": "essentials",
      "type": "multiple",
      "title": "Everyday tools",
      "description": "Handy on their own, and ready beside your documents.",
      "options": [
        {
          "app": "vaultwarden",
          "summary": "Passwords",
          "default": true,
          "answers": {
            "domain": "https://$SERVER_LAN_IP:$PORT(30032)",
            "admin_token": "",
            "SIGNUPS_ALLOWED": "True"
          }
        },
        {
          "app": "bentopdf",
          "summary": "PDF tools",
          "default": true
        }
      ]
    },
    {
      "id": "extras",
      "type": "multiple",
      "title": "More for your documents",
      "description": "Add any of these now, or later from Nextcloud's Connections tab.",
      "options": [
        {
          "app": "paperless-ngx",
          "summary": "Scanned documents",
          "requires": [
            "nextcloud"
          ]
        },
        {
          "app": "languagetool",
          "summary": "Spelling and grammar",
          "requires": [
            "collabora"
          ]
        },
        {
          "app": "drawio",
          "summary": "Diagrams",
          "requires": [
            "nextcloud"
          ]
        }
      ]
    }
  ]
}
