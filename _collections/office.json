{
  "type": "collection",
  "version": 1,
  "internal": true,
  "name": "Office suite",
  "description": "Files, documents and passwords in one place, on your own server.",
  "image": "_collections/office.jpg",
  "groups": [
    {
      "id": "suite",
      "type": "fixed",
      "title": "Your office",
      "description": "Your files, with documents you can edit together in the browser.",
      "options": [
        {
          "app": "nextcloud",
          "core": true
        },
        {
          "app": "collabora",
          "core": true
        }
      ]
    },
    {
      "id": "essentials",
      "type": "multiple",
      "title": "Everyday tools",
      "description": "Handy on their own, and ready beside your documents.",
      "options": [
        {
          "app": "vaultwarden",
          "summary": "Passwords",
          "default": true,
          "answers": {
            "domain": "https://$SERVER_LAN_IP:$PORT(30032)",
            "admin_token": "",
            "SIGNUPS_ALLOWED": "True"
          }
        },
        {
          "app": "bentopdf",
          "summary": "PDF tools",
          "default": true
        }
      ]
    },
    {
      "id": "extras",
      "type": "multiple",
      "title": "More for your documents",
      "description": "Add any of these now, or later from Nextcloud's Connections tab.",
      "options": [
        {
          "app": "paperless-ngx",
          "summary": "Scanned documents"
        },
        {
          "app": "languagetool",
          "summary": "Spelling and grammar"
        },
        {
          "app": "drawio",
          "summary": "Diagrams"
        }
      ]
    }
  ]
}
