  },
  "groups": [
    {
      "id": "engine",
      "type": "fixed",
      "title": "AI engine",
      "description": "Runs your model on your graphics card.",
      "options": [
        {
          "app": "ollama"
        }
      ]
    },
    {
      "id": "chat",
      "type": "single",
      "title": "Chat",
      "description": "Where you talk to your model.",
      "options": [
        {
          "app": "open-webui",
          "summary": "Chat, in your browser",
          "default": true
        },
        {
          "app": "anything-llm",
          "summary": "Chat with your documents"
        }
      ]
    },
    {
      "id": "assistant",
      "type": "single",
      "optional": true,
      "title": "Assistant",
      "description": "An always-on assistant that runs tasks for you. It can reach the internet and Ollama, and nothing else at home.",
      "options": [
        {
          "app": "hermes-agent",
          "summary": "Learns as it works",
          "needsModel": "agent-ready"
        },
        {
          "app": "openclaw",
          "summary": "Connects to your chat apps",
          "needsModel": "agent-ready"
        }
      ]
    },
    {
      "id": "coding",
      "type": "multiple",
      "title": "Coding",
      "description": "A coding agent in your terminal or browser.",
      "options": [
        {
          "app": "opencode",
          "summary": "Coding agent",
          "needsModel": "agent-ready",
          "minVramGB": 10
        }
      ]
    },
    {
      "id": "extras",
      "type": "multiple",
      "title": "Extras",
      "description": "Add any of these now, or later from their Connections tab.",
      "options": [
        {
          "app": "searxng",
          "summary": "Private web search for your chat"
        },
        {
          "app": "n8n",
          "summary": "Automations that use your model"
        }
      ]
    }
  ]
}
