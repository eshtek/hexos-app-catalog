{
  "type": "collection",
  "version": 2,
  "internal": true,
  "name": "Local AI",
  "description": "Run AI models on your own graphics card, with chat and assistants that stay on your server.",
  "requirements": {
    "specifications": [
      "4GBVRAM"
    ]
  },
  "localAi": {
    "minVramGB": 4,
    "uses": [
      {
        "id": "everyday",
        "title": "Everyday chat and writing",
        "models": "everyday"
      },
      {
        "id": "documents",
        "title": "Documents and research",
        "models": "everyday"
      },
      {
        "id": "coding",
        "title": "Coding",
        "models": "coding",
        "minVramGB": 8
      },
      {
        "id": "agents",
        "title": "Agents and automation",
        "models": "agents",
        "minVramGB": 10
      }
    ],
    "tiers": [
      {
        "id": "good",
        "title": "Good"
      },
      {
        "id": "better",
        "title": "Better"
      },
      {
        "id": "best",
        "title": "Best"
      }
    ],
    "rank": [
      "agents",
      "coding",
      "everyday"
    ],
    "defaultModels": "everyday",
    "models": {
