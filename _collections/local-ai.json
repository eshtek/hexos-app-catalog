            "tools": true
          }
        ],
        "best": [
          {
            "model": "qwen3.8:27b-q4_K_M",
            "sizeGB": 18,
            "minVramGB": 20,
            "contextK": 32,
            "tools": true
          }
        ]
      },
      "coding": {
        "good": [
          {
            "model": "qwen3.5:9b-q4_K_M",
            "sizeGB": 6.6,
            "minVramGB": 8,
