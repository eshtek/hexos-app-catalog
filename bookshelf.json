{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial Script"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance", "Media", "Downloads"
    ],
    "specifications": [
      "2CORE",
      "2GBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [30378]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    { "path": "$LOCATION(Media)", "network_share": true },
    { "path": "$LOCATION(Downloads)", "network_share": true },
    { "path": "$LOCATION(ApplicationsPerformance)/bookshelf/config", "owner": { "user": "apps" }, "snapshot": { "id": "config" } },
    { "path": "$LOCATION(Media)/books" },
    {
      "path": "$LOCATION(Downloads)/qbittorrent"
    }
  ],
  "app_values": {
    "bookshelf": {
      "image_selector": "image",
      "additional_envs": [
        {
          "name": "HARDCOVER_AUTH",
          "value": "$QUESTION(HARDCOVER_AUTH)"
        }
      ]
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/bookshelf/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media)/books, /books)",
        "$MOUNTED_HOST_PATH($LOCATION(Downloads)/qbittorrent, /config/Downloads)"
      ]
    }
  },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30378
      }
    },
  "resources": {
    "limits": {
      "cpus": 2,
      "memory": "$MEMORY(10%, 2048)"
    }
  }
}
