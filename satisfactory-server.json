{
  "version": 6,
  "script": {
    "version": "1.0.1",
    "changeLog": "The app card shows who's online, from the server's own log, out of how many it takes"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance"
    ],
    "specifications": [
      "4CORE",
      "8GBRAM",
      "15GB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      7777,
      8888
    ],
    "game_port": 7777,
    "instances": "many"
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/$INSTANCE(satisfactory-server)/config",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "saves"
      }
    }
  ],
  "app_values": {
    "network": {
      "game_port": {
        "bind_mode": "published",
        "port_number": "$PORT(7777)"
      },
      "messaging_port": {
        "bind_mode": "published",
        "port_number": "$PORT(8888)"
      }
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/$INSTANCE(satisfactory-server)/config)"
    },
    "resources": {
      "limits": {
        "cpus": "$CPUS(50%, 4)",
        "memory": "$MEMORY(25%, 8192)"
      }
    }
  },
  "widgets": [
    {
      "id": "players",
      "title": "Online now",
      "description": "Who's playing on this server, out of how many it takes.",
      "refresh": 10,
      "conditions": [
        {
          "role": "availability",
          "type": "appRunning",
          "app": "satisfactory-server"
        }
      ],
      "background": { "field": "online" },
      "slots": [
        { "type": "stat", "field": "count" },
        { "type": "list", "field": "online", "rows": 1 }
      ],
      "script": "satisfactory-server/widget_players.ts",
      "entrypoint": "run",
      "timeout": 5
    }
  ],
  "widgetsSchema": 3
}
