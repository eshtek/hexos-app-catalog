{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial Script"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance", "Media" ],
    "specifications": [
      "2CORE",
      "2GBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [31067]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    { "path": "$LOCATION(Media)", "network_share": true },
    { "path": "$LOCATION(ApplicationsPerformance)/calibre-web/config", "owner": { "user": "apps" }, "snapshot": { "id": "config" } },
    { "path": "$LOCATION(Media)/calibre-web/books" }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/calibre-web/config)",
      "books": "$HOST_PATH($LOCATION(Media)/calibre-web/books)"
    }
  },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 31067
      }
    },
  "resources": {
    "limits": {
      "cpus": 2,
      "memory": "$MEMORY(10%, 2048)"
    }
  }
}
