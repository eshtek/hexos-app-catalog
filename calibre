{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial Script"
  },
  "installation_questions": [
    {
      "question": "Choose a Username",
      "type": "text",
      "key": "username",
      "required": true
    },
    {
      "question": "Select a password",
      "type": "password",
      "key": "password",
      "required": true
    }
  ],
  "requirements": {
    "locations": [
      "ApplicationsPerformance", "Media", "Downloads"
    ],
    "specifications": [
      "2CORE",
      "4GBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [32014, 32015, 32016]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    { "path": "$LOCATION(Media)", "network_share": true },
    { "path": "$LOCATION(Downloads)", "network_share": true },
    { "path": "$LOCATION(ApplicationsPerformance)/calibre/config", "owner": { "user": "apps" }, "snapshot": { "id": "config" } },
    { "path": "$LOCATION(Media)/books" },
    { "path": "$LOCATION(Downloads)/calibre" }
  ],
  "app_values": {
    "calibre": {
      "additional_envs": [
        {
          "name": "NO_DECOR",
          "value": "true"
        },
        {
          "name": "QTWEBENGINE_CHROMIUM_FLAGS",
          "value": "--disable-dev-shm-usage"
        }
      ],
      "username": "$QUESTION(username)",
      "password": "$QUESTION(password)"
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/calibre/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media)/books, /books)",
        "$MOUNTED_HOST_PATH($LOCATION(Downloads)/calibre, /downloads)"
      ]
    }
  },
    "network": {
      "host_network": false,
      "http_port": {
        "bind_mode": "",
        "port_number": 32015
      },
      "https_port": {
        "bind_mode": "published",
        "port_number": 32016
      },
      "web_port": {
        "bind_mode": "published",
        "port_number": 32016
      }
    },
  "resources": {
    "limits": {
      "cpus": 2,
      "memory": "$MEMORY(10%, 4096)"
    }
  }
}
