{
  "version": 6,
  "script": {
    "version": "1.0.1",
    "changeLog": "Sign-in works at the app's Anywhere address"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance"
    ],
    "specifications": [
      "2CORE",
      "2GB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30448
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/sparkyfitness/postgres_data",
      "owner": {
        "user": "netdata",
        "group": "docker"
      },
      "snapshot": {
        "id": "db"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/sparkyfitness/uploads",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "uploads"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/sparkyfitness/backup",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "backup"
      }
    }
  ],
  "app_values": {
    "sparkyfitness": {
      "db_password": "$RANDOM_STRING(32)",
      "api_encryption_key": "$RANDOM_STRING(43)=",
      "better_auth_secret": "$RANDOM_STRING(32)",
      "frontend_url": "http://$SERVER_LAN_IP:$PORT(30448)",
      "additional_envs": [
        {
          "name": "ALLOW_PRIVATE_NETWORK_CORS",
          "value": "true"
        }
      ]
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": "$PORT(30448)"
      }
    },
    "storage": {
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/sparkyfitness/postgres_data)",
      "uploads": "$HOST_PATH($LOCATION(ApplicationsPerformance)/sparkyfitness/uploads)",
      "backup": "$HOST_PATH($LOCATION(ApplicationsPerformance)/sparkyfitness/backup)"
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  },
  "hooks": [
    {
      "id": "anywhere-address",
      "title": "Sign in at its Anywhere address",
      "description": "Letting SparkyFitness accept sign-ins at its Anywhere address",
      "summary": "SparkyFitness accepts sign-ins at its Anywhere address instead of refusing them. HexOS runs this again when the address changes.",
      "kind": "maintain",
      "events": [
        "userAction"
      ],
      "rerun": "converge",
      "rerunsOn": [
        "remote-address"
      ],
      "surfaces": [
        "card"
      ],
      "script": "sparkyfitness/anywhere.ts",
      "entrypoint": "anywhere",
      "timeout": 600,
      "retries": 0
    }
  ]
}
