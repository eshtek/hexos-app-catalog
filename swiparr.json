          "text": "Jellyfin",
          "value": "jellyfin"
        },
        {
          "text": "Emby (experimental)",
          "value": "emby"
        },
        {
          "text": "Plex (experimental)",
          "value": "plex"
        },
        {
          "text": "TMBD (No Media Server Required)",
          "value": "tmdb"
        }
      ],
      "default": "jellyfin"
    },
