  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE", "200MB"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30462]
  },
    "ensure_directories_exists": [
        {
            "path": "$LOCATION(ApplicationsPerformance)"
        },
        {
            "path": "$LOCATION(ApplicationsPerformance)/swiparr"
        },
        { "path": "$LOCATION(ApplicationsPerformance)/swiparr/data", "owner": { "user": "apps"}, "snapshot": { "id": "data" } }
    ],
  "app_values": {
    "swiparr": {
      "auth_secret": "$RANDOM_STRING(32)",
      "provider": "$QUESTION(provider)",
      "provider_lock": false ,
      "allow_private_provider_urls": true ,
      "jellyfin_url": "http://$SERVER_LAN_IP:30013",
      "emby_url": "http://$SERVER_LAN_IP:9096",
      "plex_url": "http://$SERVER_LAN_IP:32400",
      "tmdb_access_token": "QUESTION(tmdb_access_token)",
      "tmdb_default_region": "$QUESTION(tmdb_default_region)"
    },
   "storage": {
       "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/swiparr/data)"
    },
  "network": {
    "web_port": {
      "bind_mode": "published",
      "port_number": 30462
    }
  },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(5%, 1024)"
      }
    }
  }
}