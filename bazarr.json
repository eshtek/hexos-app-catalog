{
  "version": 6,
  "script": {
    "version": "1.2.0",
    "changeLog": "Mounted Shows at /shows to match Sonarr (the old /tv mount stays so an existing install's path mapping keeps working), added the Connect to Radarr and Sonarr links, and moved to the v6 install script format"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "Downloads",
      "Movies",
      "Shows"
    ],
    "specifications": [
      "2CORE",
      "512MB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30046
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Downloads)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Movies)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Shows)",
      "network_share": true
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/bazarr/config",
      "snapshot": {
        "id": "config"
      }
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/bazarr/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Downloads), /downloads)",
        "$MOUNTED_HOST_PATH($LOCATION(Movies), /movies)",
        "$MOUNTED_HOST_PATH($LOCATION(Shows), /shows)",
        "$MOUNTED_HOST_PATH($LOCATION(Shows), /tv)"
      ]
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30046
      }
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(5%, 1024)"
      }
    }
  },
  "hooks": [
    {
      "id": "connect-radarr",
      "title": "Connect to Radarr",
      "description": "Let Bazarr fetch subtitles for the movies Radarr manages",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "radarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "radarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "bazarr"
        }
      ],
      "rerun": "converge",
      "entrypoint": "connectRadarr",
      "timeout": 600,
      "script": "bazarr/connect_arrs.ts"
    },
    {
      "id": "connect-sonarr",
      "title": "Connect to Sonarr",
      "description": "Let Bazarr fetch subtitles for the shows Sonarr manages",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "sonarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sonarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "bazarr"
        }
      ],
      "rerun": "converge",
      "entrypoint": "connectSonarr",
      "timeout": 600,
      "script": "bazarr/connect_arrs.ts"
    }
  ]
}
