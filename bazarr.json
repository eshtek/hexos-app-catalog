{
  "version": 6,
  "script": {
    "version": "1.2.0",
    "changeLog": "Links to Radarr and Sonarr and fetches English subtitles with no setup"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "Downloads",
      "Movies",
      "Shows"
    ],
    "specifications": [
      "2CORE",
      "512MB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30046
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Downloads)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Movies)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Shows)",
      "network_share": true
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/bazarr/config",
      "snapshot": {
        "id": "config"
      }
    }
  ],
  "app_values": {
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/bazarr/config)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Downloads), /downloads)",
        "$MOUNTED_HOST_PATH($LOCATION(Movies), /movies)",
        "$MOUNTED_HOST_PATH($LOCATION(Shows), /tv)"
      ]
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30046
      }
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(5%, 1024)"
      }
    }
  },
  "hooks": [
    {
      "id": "configure-bazarr",
      "title": "Pre-configure Bazarr",
      "description": "Sets Bazarr up to fetch English subtitles",
      "events": [
        "onAfterInstall"
      ],
      "script": "bazarr/bazarr_hook.ts",
      "entrypoint": "configure",
      "timeout": 600,
      "optional": true,
      "retries": 0
    },
    {
      "id": "connect-radarr",
      "title": "Connect to Radarr",
      "description": "Fetches English subtitles for what Radarr manages.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "radarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "radarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "bazarr"
        }
      ],
      "rerun": "converge",
      "script": "bazarr/bazarr_hook.ts",
      "entrypoint": "radarr",
      "timeout": 300,
      "retries": 0
    },
    {
      "id": "connect-sonarr",
      "title": "Connect to Sonarr",
      "description": "Fetches English subtitles for what Sonarr manages.",
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "sonarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "sonarr"
        },
        {
          "role": "availability",
          "type": "appRunning",
          "app": "bazarr"
        }
      ],
      "rerun": "converge",
      "script": "bazarr/bazarr_hook.ts",
      "entrypoint": "sonarr",
      "timeout": 300,
      "retries": 0
    }
  ]
}
