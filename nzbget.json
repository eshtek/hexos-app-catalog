{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial release"
  },
  "installation_questions": [
    {
        "question": "Choose a username",
        "type": "text",
        "key": "NZBGET_USER",
        "required": true,
        "default": "Admin",
        "installonly": true
    },
    {
        "question": "Input an account password",
        "type": "password",
        "key": "NZBGET_PASS",
        "required": true,
        "default": "$RANDOM_STRING(16)",
        "installonly": true
     }
  ],
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "Downloads"
    ],
    "specifications": [
      "1CORE",
      "100MB",
      "1GBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      6789
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Downloads)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Downloads)/nzbget"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/nzbget/config",
      "snapshot": {
        "id": "config"
      }
    }
  ],
  "app_values": {
    "nzbget": {
      "additional_envs": [
        {
          "name": "NZBGET_USER",
          "value": "$QUESTION(NZBGET_USER)"
        },
        {
          "name": "NZBGET_PASS",
          "value": "$QUESTION(NZBGET_PASS)"
        }
      ]
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/nzbget/config)",
      "downloads": "$HOST_PATH($LOCATION(Downloads)/nzbget)"
    }
  },
  "resources": {
    "limits": {
      "cpus": 2,
      "memory": "$MEMORY(5%, 1024)"
      }
    }
}
