{
  "version": 6,
  "script": {
    "version": "1.1.0",
    "changeLog": "Installs on a server that gets its address from the router. Pi-hole now answers DNS on the server's own network connection itself"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["1CORE", "500MB"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [20720, 53],
    "home_dns": true,
    "exclusive_with": ["adguard-home"]
  },
  "sign_in": {
    "username": false
  },
  "ensure_directories_exists": [
    { "path": "$LOCATION(ApplicationsPerformance)" },
    { "path": "$LOCATION(ApplicationsPerformance)/pihole/config", "snapshot": { "id": "config" } },
    { "path": "$LOCATION(ApplicationsPerformance)/pihole/dnsmasq" }
  ],
  "app_values": {
    "pihole": {
      "web_password": "$RANDOM_STRING(32)",
      "additional_envs": [
        { "name": "PIHOLE_UID", "value": "568" },
        { "name": "PIHOLE_GID", "value": "568" },
        { "name": "FTLCONF_misc_etc_dnsmasq_d", "value": "true" },
        { "name": "FTLCONF_ntp_ipv4_active", "value": "false" },
        { "name": "FTLCONF_ntp_ipv6_active", "value": "false" },
        { "name": "FTLCONF_ntp_sync_active", "value": "false" }
      ]
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": "$PORT(20720)"
      },
      "host_network": true
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/pihole/config)",
      "dnsmasq": "$HOST_PATH($LOCATION(ApplicationsPerformance)/pihole/dnsmasq)"
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": 1024
      }
    }
  },
  "hooks": [
    {
      "id": "seed-listen",
      "title": "Keep Pi-hole on this server's address",
      "description": "Keeps Pi-hole's DNS on this server's own address, before its first start",
      "events": ["onBeforeInstall"],
      "script": "pihole/configure.ts",
      "entrypoint": "seedListen",
      "timeout": 60
    },
    {
      "id": "configure-pihole",
      "title": "Pre-configure Pi-hole",
      "description": "Gives Pi-hole the password you chose, which restarts it once",
      "summary": "Sets Pi-hole's password to the one you chose at install. Running it again from here changes nothing.",
      "events": ["onAfterInstall", "userAction"],
      "rerun": "converge",
      "surfaces": ["card"],
      "optional": true,
      "script": "pihole/configure.ts",
      "entrypoint": "configure",
      "timeout": 600,
      "retries": 0
    },
    {
      "id": "home-addresses",
      "title": "Use Anywhere addresses at home",
      "description": "Sends devices on your network straight to this server when they open an Anywhere address",
      "summary": "Devices that use Pi-hole reach your Anywhere addresses at this server itself, without leaving your network. HexOS keeps the list up to date.",
      "kind": "maintain",
      "events": ["onAfterInstall", "userAction"],
      "rerun": "converge",
      "rerunsOn": ["home-addresses"],
      "surfaces": ["card"],
      "optional": true,
      "script": "pihole/configure.ts",
      "entrypoint": "homeAddresses",
      "timeout": 300,
      "retries": 0
    }
  ]
}
