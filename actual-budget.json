{
    "version": 5,
    "script": {
        "version": "1.0.1",
        "changeLog": "added requirements"
    },
    "requirements": {
        "locations": [
            "ApplicationsPerformance"
        ],
        "specifications": [
          "2CORE",
          "2GB"
        ],
        "permissions": [
            "READ_WRITE_LOCATIONS"
        ],
        "ports": [
            31012
        ]
    },
    "ensure_directories_exists": [
        {
            "path": "$LOCATION(ApplicationsPerformance)"
        },
        {
            "path": "$LOCATION(ApplicationsPerformance)/actual-budget"
        },
        { "path": "$LOCATION(ApplicationsPerformance)/actual-budget/data", "owner": { "user": "apps"}, "snapshot": { "id": "data" } }
    ],
    "app_values": {
        "storage": {
            "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/actual-budget/data)"
        },
    "network": {
      "certificate_id": 1,
      "web_port": {
        "bind_mode": "published",
        "port_number": 31012
            }
        },
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "$MEMORY(10%, 2048)"
          }
        }
    }
}
