{
  "version": 5,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial curation"
  },
  "requirements": {
    "locations": [],
    "specifications": ["2CORE", "1GB"],
    "permissions": [],
    "ports": [30098]
  },
  "app_values": {
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30098
      }
    },
    "storage": {
      "data": {
        "type": "ix_volume",
        "ix_volume_config": {
          "acl_enable": false,
          "dataset_name": "data"
        }
      }
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  }
}
