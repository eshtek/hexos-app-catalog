{
  "version": 6,
  "internal": true,
  "script": {
    "version": "1.0.0",
    "changeLog": "Audiobookshelf opens ready, with your sign-in and your Audiobooks and Podcasts libraries."
  },
  "sign_in": {
    "username": true,
    "existing": true
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "Media"
    ],
    "specifications": [
      "2CORE",
      "500MBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30067
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Media)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Media)/audiobooks"
    },
    {
      "path": "$LOCATION(Media)/podcasts"
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/audiobookshelf/config",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "config"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/audiobookshelf/metadata",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "metadata"
      }
    }
  ],
  "app_values": {
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": "$PORT(30067)"
      }
    },
    "storage": {
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/audiobookshelf/config)",
      "metadata": "$HOST_PATH($LOCATION(ApplicationsPerformance)/audiobookshelf/metadata)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Media)/audiobooks, /audiobooks)",
        "$MOUNTED_HOST_PATH($LOCATION(Media)/podcasts, /podcasts)"
      ]
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 2048)"
      }
    }
  },
  "hooks": [
    {
      "id": "configure-audiobookshelf",
      "title": "Pre-configure Audiobookshelf",
      "description": "Setting up Audiobookshelf",
      "summary": "Makes your account and adds your Audiobooks and Podcasts libraries at install. Running it again from here changes nothing.",
      "events": [
        "onAfterInstall",
        "userAction"
      ],
      "rerun": "converge",
      "surfaces": [
        "card"
      ],
      "optional": true,
      "script": "audiobookshelf/configure.ts",
      "entrypoint": "configure",
      "timeout": 600,
      "retries": 0
    }
  ]
}
